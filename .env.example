# PostgreSQL (CDC source)
POSTGRES_DB=ecommerce
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_CDC_USER=cdc_reader
POSTGRES_CDC_PASSWORD=cdc_reader_pwd

# CDC topic namespace
CDC_TOPIC_PREFIX=ecommerce
CDC_LAG_ALERT_THRESHOLD_MS=300000

# MinIO
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=lakehouse

# MariaDB / Hive Metastore
MARIADB_ROOT_PASSWORD=root123
MARIADB_DATABASE=metastore_db
MARIADB_USER=admin
MARIADB_PASSWORD=admin123

# Airflow (local-development values; replace outside local use)
AIRFLOW_UID=50000
AIRFLOW_API_SECRET_KEY=local-dev-api-secret-change-me
AIRFLOW_FERNET_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_ADMIN_FIRSTNAME=Airflow
AIRFLOW_ADMIN_LASTNAME=Admin
AIRFLOW_ADMIN_EMAIL=airflow@localhost

# Superset
SUPERSET_SECRET_KEY=local-dev-superset-secret-change-me
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_EMAIL=admin@ecommerce.local
SUPERSET_ADMIN_PASSWORD=admin123
